.env
__pycache__/
*.pyc
venv/
cache/

# Generated reports stay out of git, but the SQLite state file is committed back
# by the scheduled workflows so each run inherits price history, open signals and
# the paper-trade ledger from the previous one.
# Note: this must be `output/*`, not `output/` — git will not descend into an
# excluded directory, so a negation inside one never takes effect.
output/*
!output/nse.db

# Derived from data/cache by data/events.py — regenerated in seconds, not committed.
data/events.parquet

# Grid outputs from data/backtest.py — trade logs and summaries, regenerable.
data/grid/

# Forward calendar snapshot from data/upcoming.py — refetched on demand.
data/upcoming.parquet

# data/notify_state.json is NOT ignored: it is the seq_id seen-ledger, the
# last-digest date and the daily alert counter, committed back by the notify
# workflow so the two daily runs on ephemeral runners share one memory.
