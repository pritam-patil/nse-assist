TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides — defaults live in src/config.py.
# SQLite state file. Committed back by scheduled runs so each run inherits
# price history, open signals and the paper-trade ledger from the previous one.
# DB_PATH=output/nse.db

# Daily OHLCV source. 'yahoo' is the only implemented one today (no key, no
# registration); the setting exists so a paid feed can be swapped in without
# touching ingest.py's callers.
# PRICE_SOURCE=yahoo

# How much history ingest pulls the first time it sees a symbol. Raising this does
# not deepen symbols already stored — run `--stage ingest --backfill` for that.
# INGEST_LOOKBACK_DAYS=1500

# AMFI publishes the full NAV dump as a plain-text file, refreshed once each
# evening. Override only if the URL moves.
# AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt

# Which schemes to track now lives in src/fund_watchlist.py — it is a decision, not
# an environment difference. This is only an override for a one-off run against a
# different set. Find codes with:
#   python main.py --stage funds --search "hdfc liquid"
# FUND_SCHEME_CODES=

# Historical NAVs come from mfapi.in, a free community-run API. Override only if it
# moves; the stage degrades to accumulating history forward from AMFI when it is down.
# MFAPI_URL=https://api.mfapi.in/mf/{code}

# --- sentiment layer (OPTIONAL) ------------------------------------------------
# Both blank is fine and is the default state. Without a key the sentiment stage
# prints one line and returns; nothing downstream depends on it. Gemini is tried
# first, Groq is the fallback — either alone works.
GEMINI_API_KEY=
GROQ_API_KEY=
